# Subh AI configuration.
# Copy to backend/.env and edit. Defaults are tuned for local development;
# GET /api/preflight lists everything that must change before deployment.

APP_NAME=Subh AI
AGENT_NAME=Subh AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- database ---
# SQLite needs no infrastructure and is the default. Switch to PostgreSQL for
# deployment; nothing else changes.
DATABASE_URL=sqlite+aiosqlite:///./subh_ai.db
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/subh_ai

# --- LLM (Phase 1) ---
# Without this the API still runs and every agent call returns
# llm_not_configured with an explanation.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
# Thinking depth / token spend: low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_SERVER_SIDE_FALLBACKS=true
# Maximum tool-use rounds in a single turn
LLM_MAX_ITERATIONS=8

# --- tools (Phase 2) ---
WEB_TIMEOUT_SECONDS=15
WEB_MAX_BYTES=400000
# Comma-separated hosts the http_api tool may reach. EMPTY MEANS NONE, which is
# the safe default - the capability stays off until you opt a host in.
API_ALLOWED_HOSTS=

# --- voice (Phase 3) ---
# browser = the client does speech recognition and synthesis (no keys needed).
# server  = audio is posted to the API; needs an STT/TTS provider registered.
VOICE_MODE=browser

# --- automation (Phase 5) ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15
TASK_RETRY_BACKOFF_SECONDS=5

# --- security (Phase 6) ---
# Signs JWTs and keys API-key hashes. Use 32+ random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Off by default so local development needs no setup. Turn this on for anything
# another machine can reach - with it off, every caller is a full admin.
AUTH_ENABLED=false
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400
# Encrypts stored secrets. If blank it is derived from SECRET_KEY, which means
# rotating SECRET_KEY would orphan every stored secret. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Origins allowed to call the API from a browser. Never use "*" with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
